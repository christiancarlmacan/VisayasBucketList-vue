generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BucketListStatus {
  WANT_TO_VISIT
  VISITED
}

model User {
  id            String            @id @default(uuid())
  name          String
  email         String            @unique
  password_hash String
  profile_image String?
  role          Role              @default(USER)
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  bucket_lists  BucketList[]
  favorites     Favorite[]
  reviews       Review[]
  achievements  UserAchievement[]

  @@map("users")
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  created_at   DateTime      @default(now())
  destinations Destination[]

  @@map("categories")
}

model Destination {
  id               String       @id @default(uuid())
  name             String
  slug             String       @unique
  description      String
  province         String
  region           String
  location         String
  latitude         Decimal?     @db.Decimal(10, 7)
  longitude        Decimal?     @db.Decimal(10, 7)
  estimated_budget Decimal?     @db.Decimal(10, 2)
  recommended_days Int?
  image_url        String?
  category_id      String
  category         Category     @relation(fields: [category_id], references: [id], onDelete: Cascade)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  bucket_lists     BucketList[]
  favorites        Favorite[]
  reviews          Review[]

  @@map("destinations")
}

model BucketList {
  id             String           @id @default(uuid())
  user_id        String
  user           User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  destination_id String
  destination    Destination      @relation(fields: [destination_id], references: [id], onDelete: Cascade)
  status         BucketListStatus @default(WANT_TO_VISIT)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@unique([user_id, destination_id])
  @@map("bucket_lists")
}

model Favorite {
  id             String      @id @default(uuid())
  user_id        String
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  destination_id String
  destination    Destination @relation(fields: [destination_id], references: [id], onDelete: Cascade)
  created_at     DateTime    @default(now())

  @@unique([user_id, destination_id])
  @@map("favorites")
}

model Review {
  id             String      @id @default(uuid())
  user_id        String
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  destination_id String
  destination    Destination @relation(fields: [destination_id], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@unique([user_id, destination_id])
  @@map("reviews")
}

model Achievement {
  id                String            @id @default(uuid())
  name              String
  description       String
  icon              String?
  requirement       Int
  created_at        DateTime          @default(now())
  user_achievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id             String      @id @default(uuid())
  user_id        String
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement_id String
  achievement    Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  earned_at      DateTime    @default(now())

  @@unique([user_id, achievement_id])
  @@map("user_achievements")
}
